{
  "version": 3,
  "cmakeMinimumRequired": {
    "major": 3,
    "minor": 20,
    "patch": 0
  },
  "configurePresets": [
    {
      "name": "windows-x64-release",
      "displayName": "Windows x64 Release (MinGW Cross)",
      "description": "Cross-compile Windows x64 release binaries using MinGW GCC; Vulkan is required and configure fails instead of silently producing CPU-only output",
      "generator": "Ninja",
      "binaryDir": "${sourceDir}/build/windows-x64-release",
      "toolchainFile": "${sourceDir}/cmake/toolchains/windows-x64-mingw.cmake",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Release",
        "BUILD_TESTING": "ON",
        "VW_REQUIRE_VULKAN": "ON"
      }
    },
    {
      "name": "windows-x64-release-cpu",
      "displayName": "Windows x64 Release CPU-only (MinGW Cross)",
      "description": "Cross-compile Windows x64 release worker without Vulkan (vlc-whisper-worker-cpu.exe, runs on loader-less machines)",
      "generator": "Ninja",
      "binaryDir": "${sourceDir}/build/windows-x64-release-cpu",
      "toolchainFile": "${sourceDir}/cmake/toolchains/windows-x64-mingw.cmake",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Release",
        "BUILD_TESTING": "ON",
        "VW_WITH_VULKAN": "OFF"
      }
    },
    {
      "name": "windows-x64-debug",
      "displayName": "Windows x64 Debug (MinGW Cross)",
      "description": "Cross-compile Windows x64 debug binaries with debug symbols",
      "generator": "Ninja",
      "binaryDir": "${sourceDir}/build/windows-x64-debug",
      "toolchainFile": "${sourceDir}/cmake/toolchains/windows-x64-mingw.cmake",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Debug",
        "BUILD_TESTING": "ON"
      }
    },
    {
      "name": "windows-x64-debug-cpu",
      "displayName": "Windows x64 Debug CPU-only (MinGW Cross)",
      "description": "Cross-compile Windows x64 debug worker without Vulkan (vlc-whisper-worker-cpu.exe, runs on loader-less machines)",
      "generator": "Ninja",
      "binaryDir": "${sourceDir}/build/windows-x64-debug-cpu",
      "toolchainFile": "${sourceDir}/cmake/toolchains/windows-x64-mingw.cmake",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Debug",
        "BUILD_TESTING": "ON",
        "VW_WITH_VULKAN": "OFF"
      }
    },
    {
      "name": "linux-x64-release",
      "displayName": "Linux x64 Release",
      "description": "Native Ubuntu/Debian x64 release build with Vulkan and DEB packaging",
      "generator": "Ninja",
      "binaryDir": "${sourceDir}/build/linux-x64-release",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Release",
        "CMAKE_INSTALL_PREFIX": "/usr",
        "BUILD_TESTING": "OFF",
        "VW_REQUIRE_VULKAN": "ON",
        "VW_PROVISION_MODELS": "ON"
      }
    },
    {
      "name": "linux-x64-debug",
      "displayName": "Linux x64 Debug (Host Native)",
      "description": "Native Linux x64 debug build for unit tests and local protocol checks",
      "generator": "Ninja",
      "binaryDir": "${sourceDir}/build/linux-x64-debug",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Debug",
        "BUILD_TESTING": "ON"
      }
    },
    {
      "name": "linux-x64-debug-cpu",
      "displayName": "Linux x64 Debug CPU-only (Host Native)",
      "description": "Native Linux x64 debug build without Vulkan (vlc-whisper-worker-cpu)",
      "generator": "Ninja",
      "binaryDir": "${sourceDir}/build/linux-x64-debug-cpu",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Debug",
        "BUILD_TESTING": "ON",
        "VW_WITH_VULKAN": "OFF"
      }
    },
    {
      "name": "linux-x64-coverage",
      "displayName": "Linux x64 Coverage",
      "description": "Native Linux x64 debug build with code coverage instrumentation",
      "generator": "Ninja",
      "binaryDir": "${sourceDir}/build/linux-x64-coverage",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Debug",
        "BUILD_TESTING": "ON",
        "ENABLE_COVERAGE": "ON"
      }
    },
    {
      "name": "macos-arm64-debug",
      "displayName": "macOS arm64 Debug (Metal)",
      "description": "Native Apple Silicon debug build; whisper.cpp uses ggml-metal",
      "generator": "Ninja",
      "binaryDir": "${sourceDir}/build/macos-arm64-debug",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Debug",
        "BUILD_TESTING": "ON",
        "VW_WITH_VULKAN": "OFF"
      }
    },
    {
      "name": "macos-arm64-debug-cpu",
      "displayName": "macOS arm64 Debug CPU-only",
      "description": "Native Apple Silicon debug build without Metal (vlc-whisper-worker-cpu)",
      "generator": "Ninja",
      "binaryDir": "${sourceDir}/build/macos-arm64-debug-cpu",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Debug",
        "BUILD_TESTING": "ON",
        "VW_WITH_VULKAN": "OFF",
        "GGML_METAL": "OFF"
      }
    },
    {
      "name": "macos-arm64-release",
      "displayName": "macOS arm64 Release (Metal)",
      "description": "Native Apple Silicon release build installing into VLC.app",
      "generator": "Ninja",
      "binaryDir": "${sourceDir}/build/macos-arm64-release",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Release",
        "BUILD_TESTING": "OFF",
        "VW_WITH_VULKAN": "OFF",
        "CMAKE_INSTALL_PREFIX": "/Applications/VLC.app/Contents/MacOS"
      }
    }
  ],
  "buildPresets": [
    {
      "name": "windows-x64-release",
      "configurePreset": "windows-x64-release"
    },
    {
      "name": "windows-x64-release-cpu",
      "configurePreset": "windows-x64-release-cpu"
    },
    {
      "name": "windows-x64-debug",
      "configurePreset": "windows-x64-debug"
    },
    {
      "name": "windows-x64-debug-cpu",
      "configurePreset": "windows-x64-debug-cpu"
    },
    {
      "name": "linux-x64-release",
      "configurePreset": "linux-x64-release"
    },
    {
      "name": "linux-x64-debug",
      "configurePreset": "linux-x64-debug"
    },
    {
      "name": "linux-x64-debug-cpu",
      "configurePreset": "linux-x64-debug-cpu"
    },
    {
      "name": "linux-x64-coverage",
      "configurePreset": "linux-x64-coverage"
    },
    {
      "name": "macos-arm64-debug",
      "configurePreset": "macos-arm64-debug"
    },
    {
      "name": "macos-arm64-debug-cpu",
      "configurePreset": "macos-arm64-debug-cpu"
    },
    {
      "name": "macos-arm64-release",
      "configurePreset": "macos-arm64-release"
    }
  ],
  "testPresets": [
    {
      "name": "windows-x64-release",
      "configurePreset": "windows-x64-release",
      "output": {
        "outputOnFailure": true
      }
    },
    {
      "name": "windows-x64-release-cpu",
      "configurePreset": "windows-x64-release-cpu",
      "output": {
        "outputOnFailure": true
      }
    },
    {
      "name": "windows-x64-debug",
      "configurePreset": "windows-x64-debug",
      "output": {
        "outputOnFailure": true
      }
    },
    {
      "name": "windows-x64-debug-cpu",
      "configurePreset": "windows-x64-debug-cpu",
      "output": {
        "outputOnFailure": true
      }
    },
    {
      "name": "linux-x64-debug",
      "configurePreset": "linux-x64-debug",
      "output": {
        "outputOnFailure": true
      }
    },
    {
      "name": "linux-x64-debug-cpu",
      "configurePreset": "linux-x64-debug-cpu",
      "output": {
        "outputOnFailure": true
      }
    },
    {
      "name": "linux-x64-coverage",
      "configurePreset": "linux-x64-coverage",
      "output": {
        "outputOnFailure": true
      }
    },
    {
      "name": "macos-arm64-debug",
      "configurePreset": "macos-arm64-debug",
      "output": {
        "outputOnFailure": true
      }
    },
    {
      "name": "macos-arm64-debug-cpu",
      "configurePreset": "macos-arm64-debug-cpu",
      "output": {
        "outputOnFailure": true
      }
    }
  ]
}
